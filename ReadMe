Steps to create a React project : 

npm create vite@latest
npm i 
npm i tailwindcss @tailwindcss/vite
npm i axios framer-motion lucide-react  react  react-dom react-icons  react-router-dom  router-dom tailwindcss 

in vite.config.ts add : 
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'
import tailwindcss from '@tailwindcss/vite'

export default defineConfig({
  plugins: [react() ,tailwindcss()],
})


in the css file add : 
@import "tailwindcss";

-------------------------------------------------------------------------------------------------------------------------

Steps to create an express project :

npm init -y
npm install axios bcrypt bcryptjs cloudinary cors dotenv express express-async-handler express-fileupload fs jsonwebtoken mongodb mongoose multer node-fetch validator
npm i -g nodemon
nodemon index.js


---------------------------------------------------------------------------------------------------------------------------

to run the front-end : npm run dev
to run the back-end : nodemon index.js

---------------------------------------------------------------------------------------------------------------------------

to inisilize Prisma run : 
npm install prisma --save-dev
npm install @prisma/client
npx prisma init


to push the Prisma schema to the database run : npx prisma db push
to generate the Prisma client run : npx prisma generate
to view the Prisma studio run : npx prisma studio

---------------------------------------------------------------------------------------------------------------------------
to push the code in GitHub (the repository must exist and contain some code already) do this :

git add .
git commit -m "Added new features" 
git push origin main --force


to pull from the GitHub do this : 

git pull 

---------------------------------------------------------------------------------------------------------------------------

To create a Mobile Project with Nativewind follow the next steps :

npx create-expo-app@latest --template                                                   
npm install nativewind react-native-reanimated@~3.17.4 react-native-safe-area-context@5.4.0
npm install --dev tailwindcss@^3.4.17 prettier-plugin-tailwindcss@^0.5.11
npx tailwindcss init

npx expo start

(remove all the files and start working in _layout as your main app and for the screens you can either put them in screens in app with _layout)


tailwind.config.js : 

/** @type {import('tailwindcss').Config} */
module.exports = {
  // NOTE: Update this to include the paths to all files that contain Nativewind classes.
  content: ["./App.tsx", "./components/**/*.{js,jsx,ts,tsx}"],
  presets: [require("nativewind/preset")],
  theme: {
    extend: {},
  },
  plugins: [],
}


global.css

@tailwind base;
@tailwind components;
@tailwind utilities;

babel.config.js

module.exports = function (api) {
  api.cache(true);
  return {
    presets: [
      ["babel-preset-expo", { jsxImportSource: "nativewind" }],
      "nativewind/babel",
    ],
  };
};

metro.config.js

const { getDefaultConfig } = require("expo/metro-config");
const { withNativeWind } = require('nativewind/metro');
 
const config = getDefaultConfig(__dirname)
 
module.exports = withNativeWind(config, { input: './global.css' })


put this in the top of _layout 
import "./global.css"


